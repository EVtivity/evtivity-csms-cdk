# Local override for config/dev.yaml. Copy to dev.local.yaml (gitignored).
# The loader deep-merges this file over dev.yaml, so list only the fields
# you change. Arrays replace the base value.

account: "123456789012"

domain:
  apex: example.com
  hostedZoneId: ZXXXXXXXXXXXXX

initialAdmin:
  email: you@example.com

# Pin one service to a different image while testing a fix:
# services:
#   api:
#     imageTag: 0.1.20-rc.1

# dev.yaml turns on every station entry point: ws:// (alb.ocppPlainWs) and
# SP3 mutual TLS (ocppTls, secret evtivity/dev/ocpp-tls with JSON keys cert,
# key, ca). Without that secret, turn SP3 off here:
# ocppTls:
#   enabled: false

# Production sizing and topology for a load test (docs/deployment.md#sizing-preset-sizing-prod).
# sizing: prod

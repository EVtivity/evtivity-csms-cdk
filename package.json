    "@types/node": "^22.15.0",
    "aws-cdk": "^2.220.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.40.0"

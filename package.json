{
  "name": "@evtivity/csms-cdk",
  "version": "0.1.40",
  "private": true,
  "type": "module",
  "description": "AWS CDK infrastructure for the EVtivity CSMS platform.",
  "license": "BUSL-1.1",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cdk": "cdk",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy",
    "prepare": "husky",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.272.0",
    "cdk-nag": "^3.0.2",
    "constructs": "^10.8.1",
    "js-yaml": "^5.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@aws-sdk/client-ecs": "^3.1141.0",
    "@aws-sdk/client-elasticache": "^3.1141.0",
    "@aws-sdk/client-secrets-manager": "^3.1141.0",
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.0",
    "aws-cdk": "^2.1143.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.1"
  },
  "engines": {
    "node": ">=22"
  }
}
